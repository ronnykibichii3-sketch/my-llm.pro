# Root environment file consumed by `docker compose` for variable interpolation.
# Copy to `.env` next to docker-compose.yml and replace the placeholder values.
# Compose never receives database credentials from the compose file itself.

# --- PostgreSQL -----------------------------------------------------------
# Credentials provisioned into the postgres container on first initialisation.
# The application never reads these; it connects through DATABASE_URL only.
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=myllm

# PostgreSQL listens on POSTGRES_PORT inside the container and is published to
# the host on POSTGRES_HOST_PORT. Port 5433 is intentional: the stock PostgreSQL
# default port is already taken by a native service on this machine, so never
# fall back to it here.
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433

# The single source of truth for the application database connection.
# Inside the compose network the host is the `postgres` service name and the
# port is POSTGRES_PORT. When running the API on the host instead, use
# `localhost` with POSTGRES_HOST_PORT (see backend/.env.example).
DATABASE_URL=postgresql+asyncpg://replace-me:replace-me@postgres:5433/myllm

# --- Host port mappings ---------------------------------------------------
API_HOST_PORT=8000
REDIS_HOST_PORT=6379
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334

# --- Application ----------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret
