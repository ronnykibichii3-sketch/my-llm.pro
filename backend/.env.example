APP_NAME=MyLLM.pro API
ENVIRONMENT=development
DEBUG=false
# Single source of truth for the database connection - the application reads
# no host, user, password or port from anywhere else. This example targets the
# API running on the host against the compose PostgreSQL published on
# POSTGRES_HOST_PORT (5433). Replace the placeholders with the values from the
# root .env; use host `postgres` instead of `localhost` when running inside
# the compose network. PostgreSQL intentionally uses the non-default 5433 port.
DATABASE_URL=postgresql+asyncpg://replace-me:replace-me@localhost:5433/myllm
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MEMORY_COLLECTION_NAME=myllm_memories
# --- Knowledge base ---------------------------------------------------------
# Knowledge vectors live in their own Qdrant collection so a knowledge search
# can never return chat memories, or vice versa, while both collections reuse
# the same embedding model and VectorStore implementation.
KNOWLEDGE_COLLECTION_NAME=myllm_knowledge
# Ingestion splits a document into chunks of at most this many characters and
# repeats up to this many characters of the previous chunk in the next one, so a
# fact that straddles a boundary stays findable from both sides.
KNOWLEDGE_CHUNK_MAX_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP=200
# Hard ceilings enforced before anything is embedded: the decoded character
# limit for a document and the raw byte limit for an uploaded request body.
KNOWLEDGE_MAX_DOCUMENT_CHARS=200000
KNOWLEDGE_MAX_UPLOAD_BYTES=2000000
# --- Prompt context ---------------------------------------------------------
# Before every chat turn the profile and the knowledge base are assembled into a
# single block of text handed to the model. These budgets are hard limits: the
# combined block is never longer than CONTEXT_MAX_CHARS, and retrieval that no
# longer fits is dropped weakest match first. PROFILE_MAX_CHARS and
# KNOWLEDGE_MAX_CHARS bound their own section, and whatever the profile does not
# spend is available to knowledge, so the two must add up to no more than
# CONTEXT_MAX_CHARS to keep both sections whole.
CONTEXT_MAX_CHARS=6000
PROFILE_MAX_CHARS=1500
KNOWLEDGE_MAX_CHARS=4500
# How many chunks a single turn retrieves before the budget is applied.
KNOWLEDGE_TOP_K=5
