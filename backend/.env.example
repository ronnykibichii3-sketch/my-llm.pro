APP_NAME=MyLLM.pro API
ENVIRONMENT=development
DEBUG=false
# Single source of truth for the database connection - the application reads
# no host, user, password or port from anywhere else. This example targets the
# API running on the host against the compose PostgreSQL published on
# POSTGRES_HOST_PORT (5433). Replace the placeholders with the values from the
# root .env; use host `postgres` instead of `localhost` when running inside
# the compose network. PostgreSQL intentionally uses the non-default 5433 port.
DATABASE_URL=postgresql+asyncpg://replace-me:replace-me@localhost:5433/myllm
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOG_LEVEL=INFO
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MEMORY_COLLECTION_NAME=myllm_memories
